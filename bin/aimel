#!/usr/bin/env bash
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PY="${AIMEL_PYTHON:-python3}"
SETTINGS="${AIMEL_SETTINGS:-$HOME/.config/aimel/settings.json}"
DEFAULT_MAIL_DIR="$HOME/_claude-email"

cli() { "$PY" "$REPO/aimel.py" "$@"; }

saved_mail_dir() {
  "$PY" - "$SETTINGS" <<'EOF'
import json, os, sys
path = os.path.expanduser(sys.argv[1])
if os.path.exists(path):
    print(json.load(open(path)).get("mail_dir", ""))
EOF
}

compose() {
  local dir="$1"; shift
  if command -v docker-compose >/dev/null 2>&1; then
    AIMEL_MAIL_DIR="$dir" docker-compose -f "$REPO/compose.yml" "$@"
  else
    AIMEL_MAIL_DIR="$dir" docker compose -f "$REPO/compose.yml" "$@"
  fi
}

resolve_mail_dir() {
  local saved prompt_default answer
  saved="$(saved_mail_dir)"
  prompt_default="${saved:-$DEFAULT_MAIL_DIR}"
  if [ -t 0 ]; then
    read -r -p "email database dir [$prompt_default]: " answer
  fi
  echo "${answer:-$prompt_default}"
}

wait_for_mailpit() {
  local base; base="$(cli settings | "$PY" -c 'import json,sys;print(json.load(sys.stdin)["api_base"])')"
  for _ in $(seq 1 30); do
    if curl -fsS -o /dev/null "$base/api/v1/info" 2>/dev/null; then return 0; fi
    sleep 1
  done
  echo "mailpit did not come up — check: $0 logs" >&2
  return 1
}

case "${1:-status}" in
  up)
    dir="$(eval echo "$(resolve_mail_dir)")"
    mkdir -p "$dir"
    cli settings --set "mail_dir=$dir" >/dev/null
    compose "$dir" up -d
    wait_for_mailpit
    cli status
    ;;
  down)
    compose "$(eval echo "$(saved_mail_dir)")" down
    ;;
  restart)
    dir="$(eval echo "$(saved_mail_dir)")"
    compose "$dir" restart
    ;;
  logs)
    compose "$(eval echo "$(saved_mail_dir)")" logs "${@:2}"
    ;;
  install-skill)
    target="${AIMEL_SKILL_DIR:-$HOME/.claude/skills/aimel}"
    mkdir -p "$target"
    cp "$REPO/skill/SKILL.md" "$target/SKILL.md"
    echo "installed skill -> $target/SKILL.md"
    ;;
  open)
    "$PY" -c 'import json,sys,webbrowser;webbrowser.open(json.load(sys.stdin)["api_base"])' < <(cli settings)
    ;;
  *)
    cli "$@"
    ;;
esac
