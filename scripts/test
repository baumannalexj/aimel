#!/usr/bin/env bash
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if command -v uv >/dev/null 2>&1; then
  PYTHONPATH="src:." uv run --quiet --project "$REPO" \
    python -m unittest discover -s test -t . "$@"
else
  PYTHONPATH="src:." python3 -m unittest discover -s test -t . "$@"
fi
